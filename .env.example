# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ourtrip@localhost:5544/ourtrip
SESSION_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000
GRAPH_DATA_DIR=./data/graphs

# Optional external providers — leave empty to disable that provider only.
# data.go.kr (공공데이터포털) key with 활용신청 for TAGO 열차정보/버스정류소/버스도착/지하철
TAGO_API_KEY=
# ODsay LAB server key (register the server's outbound IP in ODsay console)
ODSAY_API_KEY=

TRANSIT_PRIMARY_PROVIDER=odsay
ENABLE_TRANSIT_API=true
ENABLE_RAIL_API=true
ENABLE_GEOCODING=true
LOG_LEVEL=INFO
